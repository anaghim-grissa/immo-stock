{
  "name": "immo-stock-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning src/index.js",
    "dev": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning --watch src/index.js",
    "seed": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning src/seed.js",
    "create-admin": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning src/create-admin.js",
    "backup": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning src/backup.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "nodemailer": "^6.9.16"
  }
}
