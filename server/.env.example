# Port de l'API
PORT=3001
# Base MongoDB : serveur local (par défaut) ou MongoDB Atlas (mongodb+srv://utilisateur:motdepasse@cluster.../immo-stock)
MONGODB_URI=mongodb://127.0.0.1:27017/immo-stock
# Alerte "bientôt due" : nombre de jours avant l'échéance
JOURS_ALERTE_PROCHE=7
# Vérification automatique des retards toutes les N heures
VERIF_INTERVALLE_HEURES=6
# Pas plus d'une relance automatique par échéance tous les N jours
INTERVALLE_RELANCE_JOURS=7

# Envoi des relances par email (facultatif). Sans SMTP_HOST, les alertes restent dans le tableau de bord.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Expéditeur affiché, par exemple : Folla Immobilière <commercial@votresociete.tn>
SMTP_FROM=
# Copie de chaque relance envoyée à la société
ALERT_EMAIL=
